# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Optional: OKX Builder Code fee on swaps the vault executes (see lib/swapBuilder.js).
# Both must be set for the fee to apply, unset either (or both) to run fee-free. Max 3 on
# non-Solana chains per OKX's docs.
OKX_BUILDER_FEE_PERCENT=
OKX_BUILDER_REFERRER_ADDRESS=

# Optional but required for web/app/api/price-check/route.js: a second OKX project, wholly
# separate from OKX_API_KEY above, so the public price-check endpoint's traffic cannot share
# a rate budget with the vault's own reads. Leaving these unset disables the endpoint (it
# returns a clear 503 rather than silently falling back to the vault's own credentials).
OKX_PUBLIC_API_KEY=
OKX_PUBLIC_SECRET_KEY=
OKX_PUBLIC_API_PASSPHRASE=
OKX_PUBLIC_PROJECT_ID=
