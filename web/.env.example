# Local dev does NOT need this file — the app loads ../.env and ../contracts/.env
# directly (see app/server/env.js). This file documents what to set in Vercel's
# dashboard for production, since those two files are gitignored and never deployed.
#
# Project Settings -> Environment Variables on vercel.com, one entry per line below.

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
GEMINI_API_KEY=
AGENT_PRIVATE_KEY=

# Optional overrides (defaults shown are what the app falls back to if unset)
# VAULT_ADDRESS=0x03ceDFA7dd7E7274882fffE52d6f1a164F563d0b
# OWNER_ADDRESS=0x6eDFf2BC9D55dfe839bA2666e6D4653dE21875AB
# NAV_WARN_THRESHOLD_PCT=1
# NAV_BLOCK_THRESHOLD_PCT=2
